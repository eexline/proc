{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://104.128.132.216:6010/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html",
      "has": [{ "type": "header", "key": "accept", "value": "text/html" }]
    }
  ]
}
